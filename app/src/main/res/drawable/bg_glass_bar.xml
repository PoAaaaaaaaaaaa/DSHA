<?xml version="1.0" encoding="utf-8"?>
<!--
  底部导航条的玻璃底：上亮下暗 + 顶边一道折射亮线。

  为什么不用纯色：底栏下面是滚到底的内容，一条纯色横带会把内容"切断"。
  换成受光渐变 + 亮线之后，底栏读起来是一块压在上面的玻璃，而不是页面的一截。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_bar_bottom"
                android:startColor="@color/glass_bar_top"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/glass_sheen"
                android:type="linear" />
        </shape>
    </item>

    <!-- 顶边亮线：玻璃的折射边，也是与内容的分界 -->
    <item
        android:height="@dimen/stroke"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_rim" />
        </shape>
    </item>

</layer-list>
