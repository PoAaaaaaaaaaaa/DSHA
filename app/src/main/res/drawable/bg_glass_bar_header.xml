<?xml version="1.0" encoding="utf-8"?>
<!--
  顶栏的玻璃底：受光渐变 + 底边一道亮线。

  与 bg_glass_bar 的区别只有亮线在哪条边 —— 顶栏和内容的分界在下边，
  底栏和内容的分界在上边。两边都放线会得到一条"双线"，看着像没对齐。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_bar_bottom"
                android:startColor="@color/glass_bar_top"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/glass_sheen"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:height="@dimen/stroke"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_rim" />
        </shape>
    </item>

</layer-list>
