<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框：聚焦时描边变主色并加粗，给出"光标在这里"的明确反馈。
     表面用与卡片同一套玻璃渐变，但不加高光带 —— 输入框里要读文字，
     多一层高光会让浅色模式下的占位符更难看清。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/glass_bottom"
                        android:startColor="@color/glass_top"
                        android:type="linear" />
                    <corners android:radius="@dimen/radius_control" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="@dimen/radius_control" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/primary" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/glass_bottom"
                        android:startColor="@color/glass_top"
                        android:type="linear" />
                    <corners android:radius="@dimen/radius_control" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="@dimen/radius_control" />
                    <stroke
                        android:width="@dimen/stroke"
                        android:color="@color/glass_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
